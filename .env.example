# ── Logging ───────────────────────────────────────────────────────────────────
# Log level for app.* loggers. Options: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Log level for uvicorn and apscheduler. WARNING suppresses noisy access logs.
LOG_LEVEL_UVICORN=WARNING

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Set to "ollama" for local inference, "groq" for Groq cloud, or "google" for Gemini via Google AI.
LLM_PROVIDER=ollama

# ── Ollama (local) ────────────────────────────────────────────────────────────
# Install: winget install Ollama.Ollama
# Pull model: ollama pull qwen2.5:14b
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:14b

# ── Groq (cloud) ──────────────────────────────────────────────────────────────
# Required only when LLM_PROVIDER=groq
GROQ_API_KEY=gsk_...
GROQ_FIT_MODEL=llama-3.1-8b-instant
GROQ_RECOMMEND_MODEL=llama-3.3-70b-versatile

# ── Google AI / Gemini (cloud) ────────────────────────────────────────────────
# Required only when LLM_PROVIDER=google
GOOGLE_API_KEY=AIza...
GOOGLE_FIT_MODEL=gemini-2.5-flash-lite-preview-06-17
GOOGLE_RECOMMEND_MODEL=gemini-2.5-flash

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///data/jobs.db

# ── LinkedIn CV Export ────────────────────────────────────────────────────────
# Session cookie for authenticated LinkedIn scraping (from browser DevTools)
# Never commit the actual value — keep it in your local .env only
LINKEDIN_SESSION_COOKIE=
# Delay between LinkedIn profile requests (ms). Default: 2000
LINKEDIN_SCRAPE_DELAY_MS=2000
# Set to "false" to skip AI bullet rewriting during CV generation
CV_AI_REWRITE=true

# ── Comeet scraper ────────────────────────────────────────────────────────────
# Backend for Google site-search discovery. Options: vertex | cse | ddgs | google | playwright | serpapi
# "vertex" (default) uses Vertex AI Search (Discovery Engine) — requires a GCP project and
# a Web App data store restricted to comeet.com/*.
# Falls back automatically: configured primary → google → playwright when blocked/unconfigured.
GOOGLE_SEARCH_BACKEND=vertex
# Delay between Comeet page fetches (ms). Increase if you hit rate limits.
COMEET_REQUEST_DELAY_MS=2000

# ── Vertex AI Search (default Comeet discovery backend) ───────────────────────
# 1. Create a Web App data store in GCP console → Vertex AI Agent Builder → Data Stores.
# 2. Restrict it to comeet.com/* (Web Crawl / URL restriction).
# 3. Grant the "Discovery Engine Viewer" role to your service account.
# 4. Set GOOGLE_APPLICATION_CREDENTIALS to the service account JSON path,
#    OR run `gcloud auth application-default login` for ADC.
GOOGLE_CLOUD_PROJECT=
VERTEX_AI_DATA_STORE_ID=
VERTEX_AI_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=
# Optional: set to your App/Engine ID to use an engine-based serving config.
# Required if your data store is not Enterprise edition (website search needs Enterprise).
# Format: the engine ID from GCP console → Vertex AI Agent Builder → Apps.
# Serving config path becomes: .../engines/{VERTEX_AI_ENGINE_ID}/servingConfigs/default_search
VERTEX_AI_ENGINE_ID=
# Maximum results returned by Vertex AI Search per discovery call (default: 30, max: 100).
VERTEX_AI_MAX_RESULTS=30
# Query expansion mode for Vertex AI Search. Options: auto | disabled (default: auto).
# "auto" lets the API broaden the query for better recall; "disabled" sends the query verbatim.
VERTEX_AI_QUERY_EXPANSION=auto

# ── Google Custom Search Engine (legacy — existing customers only until Jan 2027) ──
# CSE is closed to new customers as of 2025. Use Vertex AI Search instead.
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
SERPAPI_KEY=

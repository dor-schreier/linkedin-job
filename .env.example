# ── LLM Provider ─────────────────────────────────────────────────────────────
# Set to "ollama" for local inference or "groq" for the Groq cloud API.
LLM_PROVIDER=ollama

# ── Ollama (local) ────────────────────────────────────────────────────────────
# Install: winget install Ollama.Ollama
# Pull model: ollama pull qwen2.5:14b
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:14b

# ── Groq (cloud) ──────────────────────────────────────────────────────────────
# Required only when LLM_PROVIDER=groq
GROQ_API_KEY=gsk_...
GROQ_FIT_MODEL=llama-3.1-8b-instant
GROQ_RECOMMEND_MODEL=llama-3.3-70b-versatile

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///data/jobs.db

# ── LinkedIn CV Export ────────────────────────────────────────────────────────
# Session cookie for authenticated LinkedIn scraping (from browser DevTools)
# Never commit the actual value — keep it in your local .env only
LINKEDIN_SESSION_COOKIE=
# Delay between LinkedIn profile requests (ms). Default: 2000
LINKEDIN_SCRAPE_DELAY_MS=2000
# Set to "false" to skip AI bullet rewriting during CV generation
CV_AI_REWRITE=true

# ── Comeet scraper ────────────────────────────────────────────────────────────
# Backend for Google site-search discovery. Options: cse | ddgs | google | playwright | serpapi
# "cse" (default) uses Google Custom Search Engine API — stable, quota-based (100 free/day).
# Falls back automatically: cse → ddgs → google → playwright when each is blocked/unconfigured.
GOOGLE_SEARCH_BACKEND=cse
# Delay between Comeet page fetches (ms). Increase if you hit rate limits.
COMEET_REQUEST_DELAY_MS=2000
# Google Custom Search Engine credentials (required when GOOGLE_SEARCH_BACKEND=cse)
# Create a Programmable Search Engine at https://programmablesearchengine.google.com
# Restrict it to comeet.com/* for cleaner results, then enable Custom Search API in GCP.
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
SERPAPI_KEY=
